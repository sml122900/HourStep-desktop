{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HourStep",
  "version": "0.2.0",
  "identifier": "com.hourstep.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HourStep Desktop",
        "url": "index.html",
        "width": 780,
        "height": 780,
        "minWidth": 620,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "HourStep 설정",
        "url": "settings.html",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "HourStep Overlay",
        "url": "overlay.html",
        "width": 640,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
